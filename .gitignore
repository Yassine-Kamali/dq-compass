# Environnement
.venv/
__pycache__/
*.pyc

# Donnees derivees : regenerees par engine/prepare_bis.py en quelques secondes.
# Seul le zip source est versionne (4,8 Mo), pas les 112 Mo qu'il produit.
data/raw/*.csv
data/prepared/

# Fichiers deposes par l'utilisateur via l'interface : ce sont des donnees
# de travail, pas du code. Le dossier lui-meme est versionne.
data/entrees/*
!data/entrees/.gitkeep

# Sorties d'execution : produites a chaque run, jamais editees a la main.
evidence/
reporting/sorties/

# Documents fournis par SG GSC, non redistribuables
docs/*.pdf

# Excel
~$*.xlsx
*.json.tmp

# Ancien catalogue Excel en ENTREE, remplace par catalogue/store.json.
# Conserve en local a titre d'archive, hors du depot pour ne pas laisser
# croire qu'il est encore la source de verite.
catalogue/*.xlsx

# Secrets Streamlit : la cle Anthropic de l'assistant IA vit ici en local et
# dans les « Secrets » de Streamlit Cloud en ligne. Jamais dans le depot.
.streamlit/secrets.toml
