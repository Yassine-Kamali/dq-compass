# Secrets de l'assistant IA du catalogue.
#
# EN LOCAL   : copiez ce fichier en `.streamlit/secrets.toml` et renseignez la
#              cle. `secrets.toml` est ignore par git - il ne doit jamais etre
#              commite. Vous pouvez aussi bien exporter la variable
#              d'environnement ANTHROPIC_API_KEY : elle a la priorite.
#
# STREAMLIT CLOUD : ne deposez pas de fichier. Ouvrez
#              « Manage app » > « Settings » > « Secrets » et collez-y les
#              memes lignes.
#
# Sans cle, DQ Compass fonctionne : le profilage, les suggestions
# deterministes, le moteur, les rapports et la piste d'audit sont intacts.
# Seul l'assistant IA se declare indisponible, et le dit a l'ecran.

# Cle API Anthropic. Obtenue sur https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY = "sk-ant-..."

# Modele interroge. Optionnel : sans cette ligne, l'assistant utilise
#              claude-sonnet-5.
# ANTHROPIC_MODEL = "claude-sonnet-5"
